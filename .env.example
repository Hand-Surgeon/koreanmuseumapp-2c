# Application
NEXT_PUBLIC_APP_URL=https://museum100.kr

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxx@sentry.io/xxxxx

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# API (if needed in future)
API_URL=https://api.museum100.kr
API_KEY=your-api-key-here

# Database (if needed in future)
DATABASE_URL=postgresql://user:password@localhost:5432/museum

# Image CDN Configuration
# Option 1: Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option 2: Imgix
NEXT_PUBLIC_IMGIX_DOMAIN=
NEXT_PUBLIC_IMGIX_TOKEN=

# Option 3: Custom CDN
NEXT_PUBLIC_IMAGE_CDN_URL=