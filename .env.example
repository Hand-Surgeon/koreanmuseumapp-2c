# Application
NEXT_PUBLIC_APP_URL=https://museum100.kr
MUSEUM_DATA_VERIFIED=false

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# eMuseum sync only (never expose these to Next.js runtime or NEXT_PUBLIC_)
MUSEUM_API_URL=https://www.emuseum.go.kr/openapi
# Legacy product only. Set true only after accepting that the key travels over HTTP.
MUSEUM_API_ALLOW_INSECURE_HTTP=false
# Use a newly issued decoded key; the sync client URL-encodes it exactly once.
MUSEUM_API_KEY=replace-with-a-rotated-decoded-server-side-key
