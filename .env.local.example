# CDN Configuration Examples

# Option 1: Cloudinary
# Sign up at https://cloudinary.com and get your cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Optional: For upload functionality
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Option 2: Imgix
# Sign up at https://imgix.com and get your domain
NEXT_PUBLIC_IMGIX_DOMAIN=your-domain.imgix.net
NEXT_PUBLIC_IMGIX_TOKEN=your-secure-url-token

# Option 3: Custom CDN (Bunny, CloudFront, etc.)
# Replace with your CDN URL
NEXT_PUBLIC_IMAGE_CDN_URL=https://cdn.example.com

# Note: Only configure ONE CDN option above.
# The system will automatically detect which CDN to use based on which environment variables are set.