{
  "name": "korean-museum-100",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "emuseum:compile": "tsc -p tsconfig.emuseum.json",
    "emuseum:discover": "npm run emuseum:compile --silent && node .cache/emuseum/scripts/emuseum-sync.js discover",
    "emuseum:inspect": "npm run emuseum:compile --silent && node .cache/emuseum/scripts/emuseum-sync.js inspect",
    "emuseum:sync": "npm run emuseum:compile --silent && node .cache/emuseum/scripts/emuseum-sync.js sync",
    "verify:emuseum": "node scripts/verify-emuseum-snapshot.js",
    "pre-deploy": "node scripts/pre-deploy-check.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.14",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "15.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.16.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3"
  }
}
